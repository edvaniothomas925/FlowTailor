{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "entities": {
    "Atelie": {
      "title": "Atelie",
      "description": "Ateliê de costura tenant details",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "emailOwner": { "type": "string" },
        "telefone": { "type": "string" },
        "plano": { "type": "string", "enum": ["basico", "pro"] },
        "ativo": { "type": "boolean" },
        "dataVencimento": { "type": "string", "format": "date-time" },
        "criadoEm": { "type": "string", "format": "date-time" }
      },
      "required": ["nome", "emailOwner", "telefone", "plano", "ativo", "criadoEm"]
    },
    "Cliente": {
      "title": "Cliente",
      "description": "Cliente cadastrada no ateliê",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "telefone": { "type": "string" },
        "email": { "type": "string" },
        "observacoes": { "type": "string" },
        "criadoEm": { "type": "string", "format": "date-time" }
      },
      "required": ["nome", "telefone", "criadoEm"]
    },
    "Medidas": {
      "title": "Medidas",
      "description": "Medidas da cliente do ateliê",
      "type": "object",
      "properties": {
        "clienteId": { "type": "string" },
        "busto": { "type": "number" },
        "cintura": { "type": "number" },
        "quadril": { "type": "number" },
        "ombro": { "type": "number" },
        "comprimentoTronco": { "type": "number" },
        "comprimentoSaia": { "type": "number" },
        "comprimentoCalca": { "type": "number" },
        "manga": { "type": "number" },
        "observacoes": { "type": "string" },
        "registradoEm": { "type": "string", "format": "date-time" }
      },
      "required": ["clienteId", "registradoEm"]
    },
    "Pedido": {
      "title": "Pedido",
      "description": "Pedido de costura ou ajuste",
      "type": "object",
      "properties": {
        "clienteId": { "type": "string" },
        "clienteNome": { "type": "string" },
        "clienteTelefone": { "type": "string" },
        "descricao": { "type": "string" },
        "tipoPeca": { "type": "string", "enum": ["vestido", "calca", "saia", "camisa", "blazer", "ajuste", "outro"] },
        "tecido": { "type": "string" },
        "valor": { "type": "number" },
        "sinalPago": { "type": "number" },
        "prazoEntrega": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["em_andamento", "aguardando_prova", "finalizado", "entregue", "cancelado"] },
        "observacoes": { "type": "string" },
        "fotoReferenciaUrl": { "type": "string" },
        "criadoEm": { "type": "string", "format": "date-time" },
        "atualizadoEm": { "type": "string", "format": "date-time" }
      },
      "required": ["clienteId", "clienteNome", "clienteTelefone", "descricao", "tipoPeca", "valor", "sinalPago", "prazoEntrega", "status", "criadoEm", "atualizadoEm"]
    },
    "SolicitacaoPagamento": {
      "title": "SolicitacaoPagamento",
      "description": "Confirmação de pagamento manual enviada pela costureira",
      "type": "object",
      "properties": {
        "atelieId": { "type": "string" },
        "atelieNome": { "type": "string" },
        "emailOwner": { "type": "string" },
        "telefoneOwner": { "type": "string" },
        "plano": { "type": "string", "enum": ["basico", "pro"] },
        "metodoPagamento": { "type": "string", "enum": ["multicaixa", "transferencia"] },
        "comprovativoUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pendente", "aprovado", "rejeitado"] },
        "observacoesAdmin": { "type": "string" },
        "solicitadoEm": { "type": "string", "format": "date-time" },
        "resolvidoEm": { "type": "string", "format": "date-time" }
      },
      "required": ["atelieId", "atelieNome", "emailOwner", "plano", "metodoPagamento", "status", "solicitadoEm"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Administrador do sistema FlowTailor",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "criadoEm": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "criadoEm"]
    },
    "ConfiguracaoPagamento": {
      "title": "ConfiguracaoPagamento",
      "description": "Dados de pagamento globais geridos pelo admin",
      "type": "object",
      "properties": {
        "numeroExpress": { "type": "string" },
        "iban": { "type": "string" },
        "banco": { "type": "string" },
        "titular": { "type": "string" },
        "whatsappAdmin": { "type": "string" }
      },
      "required": ["whatsappAdmin"]
    }
  },
  "firestore": {
    "/atelies/{atelieId}": {
      "schema": "Atelie",
      "description": "Ateliê details and metadata"
    },
    "/atelies/{atelieId}/clientes/{clienteId}": {
      "schema": "Cliente",
      "description": "Clientes associadas a um ateliê"
    },
    "/atelies/{atelieId}/medidas/{medidaId}": {
      "schema": "Medidas",
      "description": "Fichas de medidas registradas"
    },
    "/atelies/{atelieId}/pedidos/{pedidoId}": {
      "schema": "Pedido",
      "description": "Lista de pedidos de fabricação/ajustes de costura"
    },
    "/clientes/{clienteId}": {
      "schema": "Cliente",
      "description": "Clientes associadas a um ateliê com atelieId"
    },
    "/encomendas/{encomendaId}": {
      "schema": "Pedido",
      "description": "Encomendas e pedidos de confecção com atelieId"
    },
    "/medidas/{medidaId}": {
      "schema": "Medidas",
      "description": "Fichas de medidas registradas com atelieId"
    },
    "/solicitacoesPagamento/{solicitacaoId}": {
      "schema": "SolicitacaoPagamento",
      "description": "Comprovativos e solicitações de pagamento pendentes de aprovação pelo admin"
    },
    "/admins/{userId}": {
      "schema": "Admin",
      "description": "Utilizadores com permissão administrativa global"
    },
    "/configuracoes/{configId}": {
      "schema": "ConfiguracaoPagamento",
      "description": "Configurações gerais do sistema (ex: pagamento)"
    }
  }
}
