# ==============================================================================
# FLOWTAILOR — CONFIGURAÇÃO SIMPLIFICADA DE AMBIENTE (.env)
# A maioria dos valores possui padrões inteligentes para funcionamento imediato.
# ==============================================================================

# 1. BASE DE DADOS (Única variável necessária para persistência)
# Cole aqui a string de conexão PostgreSQL do Neon obtida em https://console.neon.tech
DATABASE_URL=""

# 2. IA GOOGLE GEMINI (Opcional - injetada automaticamente no AI Studio)
GEMINI_API_KEY=""

# 3. SEGREDOS DE SESSÃO & SEGURANÇA (Opcional - já possui defaults seguros)
# Pode definir um segredo personalizado para assinar tokens JWT em produção.
# JWT_SECRET="sua_chave_secreta_longa_aqui"

# 4. GOOGLE OAUTH 2.0 (Opcional - necessário apenas se quiser login com Google Cloud próprio)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
